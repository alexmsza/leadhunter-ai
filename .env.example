# LeadHunter AI - Variáveis de Ambiente (Sanitizado)
# Copie este arquivo para .env e preencha suas credenciais

# Chave de Autenticação JWT
SECRET_KEY="sua-chave-secreta-jwt-longa-e-aleatoria"

# Google Gemini AI API Key
GEMINI_API_KEY="sua-chave-api-gemini-aqui"

# Configurações de Banco de Dados / Leads
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="seu_usuario"
DB_PASSWORD="sua_senha"
DB_NAME="leadhunter_db"

# SMTP para notificações (opcional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME="seu-email@gmail.com"
EMAIL_PASSWORD="sua-senha-de-app"
