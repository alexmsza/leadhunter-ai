# LeadHunter AI - Variáveis de Ambiente (Sanitizado)
# Copie este arquivo para .env e preencha suas credenciais

# URL da API para o Frontend (Vite)
VITE_API_URL="http://localhost:8000/api"

# Chave de Autenticação JWT
SECRET_KEY="sua-chave-secreta-jwt-longa-e-aleatoria"

# Google Gemini AI API Key (Opcional)
GEMINI_API_KEY="sua-chave-api-gemini-aqui"

# Banco de Dados Local SQLite WAL (Padrão automático: local_database.db)
DATABASE_PATH="local_database.db"

# Suporte Opcional a MySQL Corporativo
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="seu_usuario"
DB_PASSWORD="sua_senha"
DB_NAME="leadhunter_db"

# SMTP para notificações (opcional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USERNAME="seu-email@gmail.com"
EMAIL_PASSWORD="sua-senha-de-app"
